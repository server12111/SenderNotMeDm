BOT_TOKEN=123456:ABC
ADMIN_IDS=123456789,987654321

# Папка с данными (БД, медиа, ключ). На хостинге: /app/data (сохраняется при перезапуске).
# DATA_DIR=/app/data

# Пусто = SQLite в DATA_DIR/bot.db. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/sender
# Пусто = FSM в памяти. Для Redis:
# REDIS_URL=redis://localhost:6379/0

# https://my.telegram.org -> API development tools (без них нельзя подключать аккаунты)
API_ID=
API_HASH=
# Пусто = ключ создаётся в DATA_DIR/session.key. Лучше задать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_KEY=
